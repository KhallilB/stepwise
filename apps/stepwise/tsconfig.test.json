{
  "extends": "./tsconfig.json",
  "include": ["e2e/**/*", "app/**/*.ts", "../../packages/platform/src/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@interview/platform": ["../../packages/platform/src/index.ts"],
      "@interview/platform/profile": ["../../packages/platform/src/Profile.tsx"],
      "@interview/platform/storage": ["../../packages/platform/src/local-state.ts"]
    },
    "jsx": "react-jsx"
  }
}
