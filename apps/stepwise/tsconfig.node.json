{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    "playwright.config.ts",
    "../../packages/platform/src/**/*"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./app/*"],
      "@interview/platform": ["../../packages/platform/src/index.ts"],
      "@interview/platform/profile": ["../../packages/platform/src/Profile.tsx"],
      "@interview/platform/storage": ["../../packages/platform/src/local-state.ts"]
    },
    "jsx": "react-jsx"
  }
}
