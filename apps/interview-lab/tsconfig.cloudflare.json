{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    "../../packages/platform/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@interview/platform": ["../../packages/platform/src/index.ts"],
      "@interview/platform/profile": ["../../packages/platform/src/Profile.tsx"],
      "@interview/platform/storage": ["../../packages/platform/src/local-state.ts"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
